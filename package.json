{
  "name": "folio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n api,web -c green,blue \"npm:dev:server\" \"npm:dev:client\"",
    "dev:stable": "concurrently --kill-others -n api,web -c green,blue \"npm:start\" \"npm:dev:client\"",
    "dev:server": "tsx watch --exclude './.local/**' --exclude './test-results/**' --exclude './playwright-report/**' server/index.ts",
    "dev:client": "vite --host 127.0.0.1 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "start": "node --import tsx server/index.ts",
    "test": "node --import tsx --test server/insurance/domain.test.ts server/studio/engine.test.ts server/agriculture/domain.test.ts server/testing/model.test.ts server/testing/references.test.ts server/testing/value-changes.test.ts server/testing/agents/pipeline.test.ts server/testing/agents/duplicate-schema.test.ts server/testing/integration.test.ts",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "scratch-blocks": "^2.1.19",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
