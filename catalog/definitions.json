  {
    "id": "workflow.issue-referred",
    "version": 1,
    "kind": "workflow",
    "label": "Issue referred property policy",
    "description": "Create, refer, survey, approve and issue a two-location policy. Parameters change this use; the shared body stays pinned.",
    "category": "Reusable workflows",
    "inputs": [
      {
        "key": "country",
        "label": "Warehouse country",
        "type": "Country",
        "required": true,
        "default": "IT",
        "options": [
          {
            "value": "DE",
            "label": "Germany"
          },
          {
            "value": "IT",
            "label": "Italy"
          }
        ]
      },
      {
        "key": "sumInsured",
        "label": "Warehouse sum insured",
        "type": "Money",
        "required": true,
        "default": 1500000
      },
      {
        "key": "floodLimit",
        "label": "Warehouse flood limit",
        "type": "Money",
        "required": true,
        "default": 1000000,
        "description": "Use a value above EUR 500,000 for this referral workflow."
      },
      {
        "key": "survey",
        "label": "Risk survey",
        "type": "DocumentFixtureRef",
        "required": true,
        "default": "approved-synthetic-survey@1"
      }
    ],
    "outputs": [
      {
        "key": "issuedPolicy",
        "label": "Issued policy",
        "type": "PolicyRef"
      },
      {
        "key": "warehouse",
        "label": "Warehouse",
        "type": "LocationRef"
      },
      {
        "key": "factory",
        "label": "Factory",
        "type": "LocationRef"
      },
      {
        "key": "quote",
        "label": "Quote request",
        "type": "QuoteRef"
      }
    ],
    "knowledgeRefs": [
      "workflow:approve-referral",
      "workflow:issue-policy",
      "rule:flood-referral"
    ],
    "readiness": "ready",
    "owner": "property-testing",
    "body": [
      {
        "id": "broker-draft",
        "definition": {
          "id": "context.actor",
          "version": 1
        },
        "inputs": {
          "role": "Broker"
        },
        "children": [
          {
            "id": "draft",
            "definition": {
              "id": "property.create-standard",
              "version": 1
            },
            "inputs": {
              "template": "two-location-property@3",
              "customer": "synthetic-manufacturer@1"
            },
            "outputs": {
              "policy": "policy",
              "factory": "factory",
              "warehouse": "warehouse",
              "customer": "customer"
            },
            "changes": [
              {
                "id": "warehouse-scope",
                "definition": {
                  "id": "context.location",
                  "version": 1
                },
                "inputs": {
                  "location": "Warehouse"
                },
                "changes": [
                  {
                    "id": "country",
                    "definition": {
                      "id": "location.set-country",
                      "version": 1
                    },
                    "inputs": {
                      "country": {
                        "param": "country"
                      }
                    }
                  },
                  {
                    "id": "value",
                    "definition": {
                      "id": "location.set-sum-insured",
                      "version": 1
                    },
                    "inputs": {
                      "amount": {
                        "param": "sumInsured"
                      }
                    }
                  },
                  {
                    "id": "flood",
                    "definition": {
                      "id": "location.add-flood",
                      "version": 1
                    },
                    "inputs": {
                      "limit": {
                        "param": "floodLimit"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "quote",
            "definition": {
              "id": "property.request-quote",
              "version": 1
            },
            "inputs": {
              "policy": {
                "ref": "policy"
              }
            },
            "outputs": {
              "quote": "quote"
            }
          },
          {
            "id": "referral-check",
            "definition": {
              "id": "quote.expect-status",
              "version": 1
            },
            "inputs": {
              "quote": {
                "ref": "quote"
              },
              "status": "Referred",
              "reason": "Flood limit exceeds broker authority"
            }
          }
        ]
      },
      {
        "id": "underwriter",
        "definition": {
          "id": "context.actor",
          "version": 1
        },
        "inputs": {
          "role": "Senior underwriter"
        },
        "children": [
          {
            "id": "survey",
            "definition": {
              "id": "property.attach-survey",
              "version": 1
            },
            "inputs": {
              "policy": {
                "ref": "policy"
              },
              "location": {
                "ref": "warehouse"
              },
              "document": {
                "param": "survey"
              }
            }
          },
          {
            "id": "approval",
            "definition": {
              "id": "quote.approve",
              "version": 1
            },
            "inputs": {
              "policy": {
                "ref": "policy"
              },
              "quote": {
                "ref": "quote"
              },
              "notes": "Risk survey reviewed. Referral approved."
            },
            "outputs": {
              "approvedQuote": "approvedQuote"
            }
          }
        ]
      },
      {
        "id": "broker-issue",
        "definition": {
          "id": "context.actor",
          "version": 1
